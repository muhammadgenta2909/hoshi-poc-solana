# Hoshi POC — copy to .env.local and fill in. .env.local is gitignored.

# Devnet RPC. Default public endpoint is rate-limited; swap for a provider URL later.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Base URL of the hoshi-backend API (NestJS, prefix /api). Marketplace + auth calls.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Optional: IDRX SPL-token mint address. If set, the top-bar balance pill shows the
# wallet's IDRX balance; if unset, it falls back to the live devnet SOL balance.
# IDRX Solana MAINNET mint (from docs.idrx.co). NOTE: there is no IDRX on devnet,
# so on the devnet POC this reads 0 — leave commented until you point at mainnet.
# NEXT_PUBLIC_IDRX_MINT=idrxZcP8xiKkYk6XGD4uz1dxEYCWSgKDHqgjsBbwDur

# Platform keypair secret as a JSON byte array — the FULL CONTENTS of platform.json.
# Generate: solana-keygen new --outfile platform.json
# Fund:     solana airdrop 2 $(solana-keygen pubkey platform.json) --url devnet
# Then paste the array here. NEVER commit this value.
PLATFORM_SECRET_KEY=[12,34,...]

# Public URL to a hosted metadata JSON (e.g. a GitHub gist raw URL).
# See metadata.example.json for the shape.
NEXT_PUBLIC_METADATA_URI=https://gist.githubusercontent.com/<you>/<id>/raw/metadata.json

# Optional — wallet address that gets the admin flag in the client UI.
# A public key, so it's safe to expose. Purely cosmetic: the backend's AdminGuard
# is what actually authorises admin API calls.
# NEXT_PUBLIC_ADMIN_WALLET=

# LOCAL DEV ONLY — do NOT set this on Vercel / any public deployment.
# NEXT_PUBLIC_* is inlined into the browser bundle, so anyone could read it and
# open the admin shell. It is ignored unless NODE_ENV=development (see
# lib/adminAuth.tsx). In production, sign in via POST /admin/login instead.
# NEXT_PUBLIC_ADMIN_SECRET=
