# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# solana platform keypair — NEVER commit
platform.json
*-keypair.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local scratch notes — may contain credentials. Never commit.
note.txt

# Agent tooling; not part of the app and not needed by the Vercel build.
.agents/
agent/
skills-lock.json

# Stray duplicate asset from a browser download.
public/visibility (1).png

.vercel
